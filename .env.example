# Token du bot Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Optionnel : sync instantané des slash commands en dev
DISCORD_GUILD_ID=

# Chemin du fichier SQLite des liens Discord ↔ Tracker.gg (défaut : data/registrations.db)
# DATABASE_PATH=data/registrations.db

# Nombre de derniers matchs proposés à la notation via /feels (défaut : 10)
# FEELS_MATCH_LIMIT=10

# DEBUG=true désactive le cooldown entre requêtes Tracker.gg (développement uniquement)
DEBUG=false
# Délai minimum entre deux scrapes Tracker.gg en secondes (défaut : 300 = 5 min)
# TRACKER_REQUEST_COOLDOWN_SECONDS=300
